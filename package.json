{
  "name": "rotorever",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "map:prepare": "python3 scripts/prepare-generated-map.py",
    "map:import-faces": "python3 scripts/prepare-cubemap.py",
    "map:test": "python3 -m unittest discover -s tests -p 'test_generated_map.py'",
    "analyze:collective": "node --experimental-strip-types scripts/collective-benchmark.ts",
    "analyze:helix": "python3 scripts/analyze_helix.py",
    "analyze:report": "python3 scripts/render_analysis.py",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.8.2",
    "vite": "6.2.6"
  }
}
